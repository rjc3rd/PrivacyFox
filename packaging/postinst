#!/bin/bash
# postinst for the privacyfox package -- runs as root, at install time.
# Fixed interpreter path (not /usr/bin/env) -- maintainer scripts need a
# known, direct interpreter, not an env-indirected one.
# Only touches system paths, deliberately never $HOME (see privacyfox
# --apply for why that split exists).

set -euo pipefail

SHARE_DIR="/usr/share/privacyfox"
TARGET_DIR="/etc/librewolf/policies"
TARGET="$TARGET_DIR/policies.json"

# Deliberately NOT <librewolf install dir>/distribution/policies.json --
# that path is real content the librewolf .deb itself ships (confirmed via
# `dpkg -S`) and isn't a registered conffile, so a future librewolf
# package upgrade would silently overwrite it back to their stock file,
# quietly undoing everything this package set. /etc/librewolf/policies/
# is the other real location Firefox's policy engine reads (confirmed
# from Mozilla's own docs) -- genuinely unclaimed, no package owns
# anything there, so this can't get silently clobbered, and doesn't need
# install-dir detection at all: Depends: librewolf already guarantees
# LibreWolf is present by the time this runs.

warn() { echo "[privacyfox] WARNING: $*" >&2; }
info() { echo "[privacyfox] $*"; }

mkdir -p "$TARGET_DIR"
if [[ -f "$TARGET" ]]; then
  cp "$TARGET" "$TARGET.bak.$(date +%Y%m%d%H%M%S)" || warn "couldn't back up existing policies.json"
fi
cp "$SHARE_DIR/distribution/policies.json" "$TARGET" \
  && info "policies.json installed to $TARGET" \
  || warn "couldn't install policies.json"

echo
info "System-wide setup done. Each user who wants PrivacyFox's hardened"
info "profile settings should now run:  privacyfox --apply"
info "(no sudo needed for that step -- it only touches your own profile)"

exit 0
