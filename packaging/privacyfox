#!/usr/bin/env bash
#
# privacyfox
#
# privacyfox --apply
#   Run this once, as yourself (no sudo), after installing the `privacyfox`
#   package. The package itself already installed policies.json system-wide
#   during `apt install` -- this does the one remaining piece that has to
#   run as a real user: dropping the hardened user.js (and userContent.css)
#   into your actual LibreWolf profile. Safe to re-run any time (e.g. after
#   `apt upgrade privacyfox` ships an updated PrivacyFox.js) -- backs up
#   whatever's already there first. If LibreWolf has never been launched
#   before (no profile exists yet), this bootstraps one itself -- a brief
#   headless launch just long enough to create it, then closes it again.
#
# privacyfox --revert
#   Undoes the profile side of things: restores the newest pre-PrivacyFox
#   backup of user.js/userContent.css (or removes the file entirely if no
#   backup exists, i.e. the profile had none before PrivacyFox touched it).
#   Run this BEFORE `sudo apt purge privacyfox`, not after -- purge removes
#   this very command along with the rest of the package. Purge alone only
#   undoes the system-wide policy (Accounts, force-installed extensions);
#   it can't reach into your profile at all -- that's this command's job.
#
# Why the profile side isn't handled automatically by the package: Debian
# packaging rules don't allow postinst/postrm scripts (which run as root,
# with no specific user session) to write into a user's $HOME -- that has
# to be a separate, per-user step, run by that user, either direction.
#
# Both modes launch LibreWolf for real at the end, so you see the result
# immediately.

set -uo pipefail

SHARE_DIR="/usr/share/privacyfox"

warn() { echo "[privacyfox] WARNING: $*" >&2; }
die()  { echo "[privacyfox] ERROR: $*" >&2; exit 1; }
info() { echo "[privacyfox] $*"; }
usage() {
  cat <<'EOF' >&2
Usage: privacyfox --apply | --revert

  --apply    Drop the hardened user.js (and userContent.css) into your
             LibreWolf profile. Run this once after installing the
             privacyfox package. Safe to re-run any time, e.g. after
             an updated PrivacyFox.js ships in an apt upgrade.

  --revert   Undo the --apply above: restore your profile's original
             user.js/userContent.css from backup (or remove them, if
             the profile had none before). Run this BEFORE
             `sudo apt purge privacyfox`, not after -- purge removes
             this very command.
EOF
  exit "${1:-1}"
}

# LibreWolf (Firefox 147+ base) falls back to ~/.config/librewolf/librewolf
# via XDG Base Directory support, but ONLY when the legacy ~/.librewolf
# doesn't already exist -- confirmed on real hardware by PrivacyOS. Check
# legacy first, matching the browser's own real compatibility rule.
resolve_librewolf_profile_root() {
  if [[ -d "$HOME/.librewolf" ]]; then
    echo "$HOME/.librewolf"
  else
    echo "${XDG_CONFIG_HOME:-$HOME/.config}/librewolf/librewolf"
  fi
}

resolve_default_profile_dir() {
  local profile_root
  profile_root="$(resolve_librewolf_profile_root)"
  local profiles_ini="$profile_root/profiles.ini"
  [[ -f "$profiles_ini" ]] || return 1

  local profile_name
  profile_name="$(awk '
    /^\[Install/ { in_install=1; next }
    /^\[/        { in_install=0 }
    in_install && /^Default=/ { sub(/^Default=/, ""); print; exit }
  ' "$profiles_ini")"

  [[ -n "$profile_name" ]] || return 1
  local dir="$profile_root/$profile_name"
  [[ -d "$dir" ]] || return 1
  echo "$dir"
}

bootstrap_profile() {
  info "No existing profile found -- launching LibreWolf briefly to create one..."
  librewolf --headless >/dev/null 2>&1 &
  local pid=$!
  sleep 6
  kill "$pid" >/dev/null 2>&1 || true
  wait "$pid" 2>/dev/null || true
}

revert_profile() {
  local profile_dir
  profile_dir="$(resolve_default_profile_dir)"
  [[ -n "$profile_dir" ]] || die "No LibreWolf profile found -- nothing to revert."
  info "Found profile at $profile_dir"

  local target="$profile_dir/user.js"
  local latest_backup
  latest_backup="$(ls -1t "$target".bak.* 2>/dev/null | head -n1 || true)"
  if [[ -n "$latest_backup" ]]; then
    mv "$latest_backup" "$target" || die "couldn't restore $latest_backup"
    info "Restored user.js from $(basename "$latest_backup")"
  elif [[ -f "$target" ]]; then
    rm -f "$target" || warn "couldn't remove $target"
    info "Removed user.js (no prior backup existed -- profile had none before PrivacyFox)"
  else
    info "No user.js present -- nothing to revert there."
  fi

  local css_target="$profile_dir/chrome/userContent.css"
  local latest_css_backup
  latest_css_backup="$(ls -1t "$css_target".bak.* 2>/dev/null | head -n1 || true)"
  if [[ -n "$latest_css_backup" ]]; then
    mv "$latest_css_backup" "$css_target" || warn "couldn't restore $latest_css_backup"
    info "Restored userContent.css from $(basename "$latest_css_backup")"
  elif [[ -f "$css_target" ]]; then
    rm -f "$css_target" || warn "couldn't remove $css_target"
    info "Removed userContent.css (no prior backup existed)"
  fi

  echo
  info "Done. Profile reverted. Launching LibreWolf..."
  setsid librewolf >/dev/null 2>&1 &
}

apply_profile() {
  [[ -f "$SHARE_DIR/PrivacyFox.js" ]] || die "$SHARE_DIR/PrivacyFox.js not found -- is the privacyfox package actually installed?"

  local profile_dir
  profile_dir="$(resolve_default_profile_dir)"
  if [[ -z "$profile_dir" ]]; then
    bootstrap_profile
    profile_dir="$(resolve_default_profile_dir)"
  fi
  if [[ -z "$profile_dir" ]]; then
    die "Couldn't create or find a LibreWolf profile. Something's wrong with the LibreWolf install itself -- try launching it manually once to see what happens."
  fi
  info "Found profile at $profile_dir"

  local target="$profile_dir/user.js"
  if [[ -f "$target" ]]; then
    cp "$target" "$target.bak.$(date +%Y%m%d%H%M%S)" || warn "couldn't back up existing user.js"
  fi
  cp "$SHARE_DIR/PrivacyFox.js" "$target" || die "couldn't write $target"
  info "user.js installed to $target"

  if [[ -f "$SHARE_DIR/userContent.css" ]]; then
    mkdir -p "$profile_dir/chrome"
    local css_target="$profile_dir/chrome/userContent.css"
    if [[ -f "$css_target" ]]; then
      cp "$css_target" "$css_target.bak.$(date +%Y%m%d%H%M%S)" || warn "couldn't back up existing userContent.css"
    fi
    cp "$SHARE_DIR/userContent.css" "$css_target" \
      && info "userContent.css installed to $css_target" \
      || warn "couldn't install userContent.css"
  fi

  echo
  info "Done. Launching LibreWolf..."
  setsid librewolf >/dev/null 2>&1 &
}

main() {
  case "${1:-}" in
    --apply|--revert) ;;
    ""|-h|--help) usage 0 ;;
    *) usage 1 ;;
  esac

  if pgrep -x librewolf >/dev/null 2>&1 || pgrep -f '/librewolf$' >/dev/null 2>&1; then
    die "LibreWolf is currently running. Close it first -- it rewrites user.js/prefs.js on exit and would overwrite what this command does."
  fi

  if [[ "$1" == "--revert" ]]; then
    revert_profile
  else
    apply_profile
  fi
}

main "$@"
